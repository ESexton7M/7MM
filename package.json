{
  "name": "asana-analytics-dashboard",
  "private": true,
  "version": "0.1.0",
  "main": "app.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node app.js",
    "install:all": "npm install && cd analyzer && npm install",
    "build": "cd analyzer && npm run build",
    "dev": "concurrently -k -n server,vite -c blue,green \"cross-env PORT=8080 node app.js\" \"cd analyzer && npm run dev\"",
    "lint": "cd analyzer && npm run lint",
    "refresh": "node -e \"fetch(process.env.URL||'http://localhost:8080/api/cache/refresh',{method:'POST',headers:{'x-refresh-secret':process.env.REFRESH_SECRET||''}}).then(r=>r.json()).then(d=>console.log(d)).catch(e=>{console.error(e);process.exit(1);})\""
  },
  "dependencies": {
    "axios": "^1.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3"
  }
}
