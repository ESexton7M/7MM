# Client-side environment variables for the analyzer frontend (Vite).
# Only VITE_ prefixed variables are inlined into the browser bundle, so
# never put secrets here. The Asana token lives ONLY in the server's .env
# at the project root (see /.env.example), not here.

# Google OAuth Client ID used by the sign-in screen.
# OAuth client IDs are public by design - safe to ship to the browser.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
