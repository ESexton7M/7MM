# Server-side environment variables for the Asana Analytics Dashboard
# Copy this file to .env in the project root and fill in your real values.
# The .env file is gitignored and is loaded by app.js via dotenv on startup.

# Asana Personal Access Token. REQUIRED for the server to fetch data.
# Generate at https://app.asana.com/0/my-apps
# NOTE: this token is read only by the Node server (app.js). It is NOT
# exposed to the browser. Do not prefix with VITE_ - that would inline it
# into the client bundle.
ASANA_TOKEN=your_asana_personal_access_token_here

# Optional. Defaults to https://app.asana.com/api/1.0
# ASANA_API_BASE=https://app.asana.com/api/1.0

# Optional. Port the Express server listens on locally.
# In production Plesk sets PORT itself; this value is ignored there.
# Pick something other than 3000 in dev so it does not collide with Vite.
PORT=8080

# Optional. How often (in days) the server refreshes its Asana cache.
# Defaults to 2. Minimum 1.
# REFRESH_INTERVAL_DAYS=2

# Optional. If set, POST /api/cache/refresh and DELETE /api/cache/clear
# require this value in the x-refresh-secret header. Leave unset to allow
# unauthenticated refresh triggers (fine for internal/IP-restricted deploys).
# REFRESH_SECRET=
